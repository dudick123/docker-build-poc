# syntax=docker/dockerfile:1

# ============================================================================
# STAGE 1: deps
#
# Installs ALL dependencies (including devDependencies) needed for building.
# Separating dependency installation from the build step allows Docker to
# cache the node_modules layer independently of source code changes.
#
# This stage is kept separate from 'build' so that the devDependency
# install (which includes the TypeScript compiler, ESLint, etc.) is cached
# independently of the Next.js build itself.
# ============================================================================
FROM node:22-alpine AS deps

WORKDIR /app

# Receive the platform Azure Artifacts npm registry URL.
ARG NPM_REGISTRY

# Configure npm with the platform Azure Artifacts feed credentials.
# The auth token is mounted as a BuildKit secret — never stored in any layer.
RUN --mount=type=secret,id=npm_token,env=NPM_TOKEN \
    npm config set registry "${NPM_REGISTRY}" && \
    npm config set "//${NPM_REGISTRY#https://}:_authToken" "${NPM_TOKEN}"

COPY package.json package-lock.json ./

# Install all dependencies including devDependencies (needed for TypeScript build).
# --prefer-offline uses the npm cache when available.
RUN npm ci --prefer-offline

# ============================================================================
# STAGE 2: build
#
# Runs 'next build' to compile the Next.js application.
# With 'output: standalone' in next.config.js, Next.js produces a
# self-contained server at .next/standalone/ that includes only the
# runtime dependencies needed to serve the application.
#
# The standalone output:
# - Copies only production node_modules needed by the server
# - Does NOT include the full node_modules/ tree
# - Includes a server.js that replaces the full next start command
# ============================================================================
FROM node:22-alpine AS build

WORKDIR /app

# Copy the installed node_modules from deps stage.
COPY --from=deps /app/node_modules ./node_modules

# Copy all source files.
COPY . .

# GIT_COMMIT_SHA: injected by the platform pipeline.
# Exposed to client-side code as a public environment variable.
ARG GIT_COMMIT_SHA=dev
ENV NEXT_PUBLIC_GIT_COMMIT_SHA=${GIT_COMMIT_SHA}

# Build the Next.js application.
# next.config.js must specify 'output: standalone' for this Dockerfile pattern.
# The build writes to:
#   .next/standalone/        — self-contained production server
#   .next/static/            — static assets (JS chunks, CSS, fonts)
#   public/                  — original public directory (pass-through assets)
RUN npm run build

# ============================================================================
# STAGE 3: final
#
# Minimal Node.js production image. Uses only the artifacts produced by the
# Next.js standalone build — no full node_modules, no TypeScript, no build tools.
#
# The standalone server (server.js) is a stripped-down HTTP server that serves
# Next.js SSR pages and API routes without requiring 'next start'.
#
# Image size comparison:
#   Full node + next: ~1.5GB
#   Standalone (this): ~250–400MB
# ============================================================================
FROM node:22-alpine AS final

ARG GIT_COMMIT_SHA=dev

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_PUBLIC_GIT_COMMIT_SHA=${GIT_COMMIT_SHA} \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Create a non-root user. 'node' is a pre-created user in official Node images.
USER node

# Copy the standalone server output. This directory includes:
#   server.js               — the production server entry point
#   node_modules/           — only the runtime deps next.js actually uses
#   .next/server/           — server-side rendering modules
COPY --from=build --chown=node:node /app/.next/standalone ./

# Static assets are NOT included in the standalone directory.
# They must be copied separately and served from the correct path.
# Next.js expects:
#   .next/static/ → served at /_next/static/
#   public/       → served at /
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public

EXPOSE 3000

# server.js is the standalone production server generated by Next.js.
# It reads PORT and HOSTNAME from the environment.
CMD ["node", "server.js"]
